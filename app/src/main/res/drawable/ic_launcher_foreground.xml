<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Shield Crest -->
    <path
        android:pathData="M 54,26 L 34,32 L 34,54 C 34,70 54,82 54,82 C 54,82 74,70 74,54 L 74,32 Z"
        android:strokeWidth="3.5"
        android:strokeLineJoin="round"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="34"
                android:startY="26"
                android:endX="74"
                android:endY="82"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF9F0A" /> <!-- Neon Orange -->
                <item android:offset="1.0" android:color="#FFFF3B30" /> <!-- Resistance Red -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Stopwatch Face: Semi-transparent White Outline -->
    <path
        android:pathData="M 54,39 A 12,12 0 1 1 53.99,39 Z"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="2" />

    <!-- Clock ticking details -->
    <!-- Top Crown button -->
    <path
        android:pathData="M 54,39 L 54,36"
        android:strokeColor="#80FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Diagonal side button -->
    <path
        android:pathData="M 62.48,42.52 L 64.6,40.4"
        android:strokeColor="#80FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Glowing Center Pivot & Needle -->
    <path
        android:pathData="M 54,51 L 62,43"
        android:strokeWidth="2.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54"
                android:startY="51"
                android:endX="62"
                android:endY="43"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFCC00" /> <!-- Glow Yellow -->
                <item android:offset="1.0" android:color="#FFFF9F0A" /> <!-- Neon Orange -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Center pivot dot -->
    <path
        android:pathData="M 54,51 A 1.5,1.5 0 1 1 53.99,51 Z"
        android:fillColor="#FFFFCC00" />

</vector>
